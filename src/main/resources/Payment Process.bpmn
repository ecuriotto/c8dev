  <bpmn:process id="PaymentProcess" name="Payment process" isExecutable="true">
    <bpmn:extensionElements />
    <bpmn:sequenceFlow id="Flow_00c34by" sourceRef="StartEvent_1" targetRef="Activity_12hmv3w" />
    <bpmn:exclusiveGateway id="creditSufficientGateway" name="Credit sufficient?" default="Flow_03cijic">
      <bpmn:incoming>Flow_1g6tjlr</bpmn:incoming>
      <bpmn:outgoing>Flow_1vx65bh</bpmn:outgoing>
      <bpmn:outgoing>Flow_03cijic</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1g6tjlr" sourceRef="Activity_12hmv3w" targetRef="creditSufficientGateway" />
    <bpmn:sequenceFlow id="Flow_1vx65bh" name="Yes" sourceRef="creditSufficientGateway" targetRef="Gateway_1xcwh8l">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=openAmount &lt;= 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Gateway_1xcwh8l">
      <bpmn:incoming>Flow_0e64ocs</bpmn:incoming>
